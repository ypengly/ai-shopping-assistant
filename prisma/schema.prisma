generator client {
  provider = "prisma-client-js"
}

// SQLite for local development. To move to PostgreSQL, change `provider` to
// "postgresql" and point DATABASE_URL at your server (see README.md).
// Enum-like fields (role, status) are plain strings so the schema works on both.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CUSTOMER") // CUSTOMER | ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wishlist        Wishlist[]
  preference      ShoppingPreference?
  conversations   Conversation[]
  recommendations Recommendation[]
  productViews    ProductView[]
  searchLogs      SearchLog[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  logo     String?
  products Product[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String
  shortDescription String   @default("")
  price            Float
  originalPrice    Float? // set when discounted; discount % is derived
  stock            Int      @default(0)
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  brandId          String?
  categoryId       String
  status           String   @default("ACTIVE") // ACTIVE | INACTIVE
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category        Category         @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  tags            ProductTag[]
  specs           ProductSpec[]
  wishlist        Wishlist[]
  recommendations Recommendation[]
  views           ProductView[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status, featured])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String  @default("")
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  color     String?
  size      String?
  sku       String  @unique
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductTag {
  id        String  @id @default(cuid())
  productId String
  tag       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tag])
  @@index([tag])
}

// Key/value specifications (e.g. "RAM" = "16GB"). The AI may only cite these.
model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  key       String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model ShoppingPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  preferences String   @default("{}") // JSON text: categories, brands, colors, sizes
  budgetMin   Float?
  budgetMax   Float?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id              String           @id @default(cuid())
  userId          String
  title           String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        Message[]
  recommendations Recommendation[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Recommendation {
  id             String        @id @default(cuid())
  userId         String
  conversationId String?
  productId      String
  reason         String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([productId])
}

// Analytics (used by the admin dashboard in Phase 8)
model ProductView {
  id        String   @id @default(cuid())
  userId    String?
  productId String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model SearchLog {
  id          String   @id @default(cuid())
  userId      String?
  query       String
  parsed      String? // JSON text of the extracted requirements
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// Site-wide settings: contact channel, AI recommendation settings, etc.
model Setting {
  key   String @id
  value String
}
