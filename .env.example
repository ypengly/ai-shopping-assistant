# --- Database -------------------------------------------------------------
# SQLite for local development. The path is relative to prisma/schema.prisma,
# so this creates prisma/dev.db. For PostgreSQL, see README.md ("Moving to PostgreSQL").
DATABASE_URL="file:./dev.db"

# --- Authentication -------------------------------------------------------
# Signs session cookies. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- First admin account (created by `npx prisma db seed`) ----------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123"

# --- AI provider (used from Phase 4 onward, server-side only) --------------
AI_API_KEY=""
